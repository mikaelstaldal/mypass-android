<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="nu.staldal.mypass.permission.FETCH_PASSWORD"
        android:label="@string/fetch_password_permission_label"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:name=".MyPassApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyPass">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".integration.FetchPasswordActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/fetch_password_activity_label"
            android:permission="nu.staldal.mypass.permission.FETCH_PASSWORD"
            android:taskAffinity=""
            android:theme="@style/Theme.MyPass"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="nu.staldal.mypass.action.FETCH_PASSWORD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Opened by the autofill framework when a fill request finds the vault
          locked. Not exported: only the framework's own PendingIntent, created
          by this app, ever launches it.
        -->
        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.MyPass.Transparent"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".autofill.BrowserEnrollmentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.MyPass.Transparent" />

        <!-- Opened when the framework offers to save a login. -->
        <activity
            android:name=".autofill.AutofillSaveActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.MyPass.Transparent"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".autofill.MyPassAutofillService"
            android:exported="true"
            android:label="@string/autofill_service_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>
    </application>
</manifest>
